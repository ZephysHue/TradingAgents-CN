+def completed_align(frame: pd.DataFrame, index: pd.DatetimeIndex, delta: pd.Timedelta) -> pd.DataFrame:
+    shifted = frame.copy(); shifted.index = shifted.index + delta
+    return shifted.reindex(index, method="ffill")
+
